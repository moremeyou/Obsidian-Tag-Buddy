{
	"name": "TagBuddy",
	"version": "0.6.10",
	"description": "Add, edit and remove tags in reading mode. Copy, move or edit tagged blocks in reading and edit mode.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "cd .. && src/node_modules/.bin/eslint \"src/*.ts\" --config src/eslint.config.mjs",
		"test:tag-patterns": "node scripts/test-tag-patterns.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"build:artifact": "node esbuild.config.mjs production",
		"deploy:tag-buddy": "npm run build && node scripts/deploy-tag-buddy.mjs",
		"verify:tag-buddy": "node scripts/deploy-tag-buddy.mjs --verify-only"
	},
	"keywords": [],
	"author": "David Fasullo",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^24.12.2",
		"@typescript-eslint/eslint-plugin": "^8.59.1",
		"@typescript-eslint/parser": "^8.59.1",
		"builtin-modules": "^5.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.2.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.12.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"yarn": "^1.22.19"
	}
}
