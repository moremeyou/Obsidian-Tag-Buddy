{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2018",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
	"strict": false,
    "importHelpers": true,
    "isolatedModules": true,
	"strictNullChecks": true,
    "lib": [
      "DOM",
      "ES2019"
    ],
    "paths": {
      "main": [
        "src/main"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "styles.css"
  ],
  "exclude": [
    "node_modules",
    "src/.node_modules.root-owned-backup-*"
  ]
}
